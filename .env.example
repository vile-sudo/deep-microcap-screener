# Copy this to .env on the server (never commit the real .env -- it's
# gitignored) and fill in the values you need. docker-compose.yml reads
# .env automatically from the same directory. Every line here is optional;
# leave a value blank and the feature it powers just stays off, same as on
# Render -- see README.md and DEPLOYMENT.md for what each one does.

# --- Database ---------------------------------------------------------
# Left unset, the app uses a local SQLite file (fine for one instance).
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/screener

# --- App ---------------------------------------------------------------
ENVIRONMENT=production
CORS_ORIGINS=*

# --- Accounts: log in / sign up ----------------------------------------
# Creates (and keeps in sync) the admin account at startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Zerodha Kite Connect (Market view live prices) ---------------------
KITE_API_KEY=
KITE_API_SECRET=
KITE_ADMIN_KEY=

# --- News Channel (newsdata.io, one of its two sources) ------------------
NEWSDATA_API_KEY=

# --- GitHub Actions dispatch (admin "Refresh now" buttons) ---------------
# A fine-grained GitHub token, Actions: Read and write, scoped to this repo.
GITHUB_REPO=vile-sudo/deep-microcap-screener
GITHUB_BRANCH=main
GH_DISPATCH_TOKEN=

# --- External cron pinger (News Channel real-time refresh) --------------
# A password you make up -- see README.md's News Channel section.
CRON_KEY=

# --- Desktop notifications (Web Push, India board Alerts settings) ------
# One VAPID keypair for this deployment -- see backend/app/config.py's comment
# for the one-line command that generates it. Leave blank and the "Desktop
# notifications" toggle explains it isn't set up yet; nothing else is affected.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
