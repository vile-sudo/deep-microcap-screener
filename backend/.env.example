# Copy to .env and adjust. Every value here has a sane default (see app/config.py)
# so the app runs with none of this set.

# SQLite (default) needs nothing. For Postgres in production:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/screener
DATABASE_URL=sqlite:///./data/screener.db

ENVIRONMENT=development

# Comma-separated origins allowed to call the API from a browser, or "*" for any.
# Tighten this to your real frontend domain in production.
CORS_ORIGINS=*
