__pycache__/
*.pyc
.venv/
venv/
backend/data/screener.db
backend/.env
.DS_Store
*.egg-info/

# Weekly discovery pipeline (automation/) -- local working state and secrets,
# never something to commit. candidates-queue.json, reviewed-symbols.json and
# profiles/ ARE committed (git add'd explicitly by publish-candidates.cmd) --
# they're the pipeline's record, not scratch.
automation/deploy-hook.txt
automation/data/listings-snapshot.json
automation/data/last-run.json
automation/data/weekly.log

# scan-asme.mjs's Playwright dependency -- package.json and package-lock.json
# ARE committed so `npm install` reproduces it. The Chromium binary `npx
# playwright install chromium` downloads lives outside the repo entirely
# (%LOCALAPPDATA%\ms-playwright on Windows), so only node_modules itself
# needs excluding here.
automation/node_modules/
