__pycache__/
*.pyc
.venv/
venv/
backend/data/screener.db
backend/.env
.env
.DS_Store
*.egg-info/

# Weekly discovery pipeline (automation/) -- local working state and secrets,
# (listings-snapshot.json IS committed now: the discovery workflow on GitHub
# needs last week's symbol lists to tell a new listing from an old one)
# never something to commit. candidates-queue.json, reviewed-symbols.json and
# profiles/ ARE committed (git add'd explicitly by publish-candidates.cmd) --
# they're the pipeline's record, not scratch.
automation/deploy-hook.txt
automation/data/last-run.json
automation/data/weekly.log

# scan-asme.mjs's Playwright dependency -- package.json and package-lock.json
# ARE committed so `npm install` reproduces it. The Chromium binary `npx
# playwright install chromium` downloads lives outside the repo entirely
# (%LOCALAPPDATA%\ms-playwright on Windows), so only node_modules itself
# needs excluding here.
automation/node_modules/

# Chart gallery: the raw NSE/BSE daily bhavcopy cache update_charts.py builds
# from. Rebuildable from the exchanges in about a minute, and kept between
# GitHub Action runs by actions/cache -- chart_data/ is what gets committed.
backend/.bhav_cache/

# "Screen any Chart" charts every actively traded NSE/BSE company, not just the
# board's. That is thousands of files and hundreds of MB rewritten every night,
# which would bloat this repo's history badly -- so the candles are uploaded as
# a GitHub release asset instead (see .github/workflows/charts.yml) and fetched
# on demand by routers/charts.py. Only the small search index,
# backend/chart_data/universe.json, is committed.
backend/universe_charts/
backend/universe-charts.tar.gz

# Same split for the US board (app/charts_us.py, scripts/update_us_charts.py,
# .github/workflows/charts_us.yml) -- Polygon.io's own local day-cache and
# the big per-ticker universe files, uploaded as a separate release asset
# ("charts-us"). Only backend/chart_data_us/universe.json is committed.
backend/.polygon_cache/
backend/universe_charts_us/
backend/universe-charts-us.tar.gz

# scripts/backfill_full_history.py: full listing-to-date OHLCV for every
# actively traded NSE/BSE company (~1996 to today), a local research dataset.
# Its own raw-day cache and output are both far too big to commit.
backend/.bhav_cache_full/
backend/full_history/

# Movers: bhavcopy, corporate actions, announcements, deals and news, cached
# per trading day while scripts/run_movers.py runs. Rebuildable from NSE and
# Google News in a few minutes; only the scan's own output, backend/data/movers/,
# is committed.
backend/.movers_cache/

# deep-dive report pipeline scratch output (reports themselves live in backend/reports/)
reports-dry/
reports-pdf/
reports-today.txt
